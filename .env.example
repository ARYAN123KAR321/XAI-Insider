# Copy to .env and adjust. NEVER commit real secrets.
DATABASE_URL=sqlite:///./data/xai_insider.db
# For Docker Compose / PostgreSQL use:
# DATABASE_URL=postgresql+psycopg2://xai:xai@db:5432/xai_insider

JWT_SECRET=change-me-to-a-long-random-string
TOKEN_TTL_HOURS=8

# Local single-process demo runs the worker inside the API process.
# In Docker Compose set EMBEDDED_WORKER=false (a dedicated worker service runs).
EMBEDDED_WORKER=true

API_BASE_URL=http://localhost:8000

# Synthetic demo credentials (local lab only)
DEMO_ADMIN_PASSWORD=XAI-Admin-2026!
DEMO_ANALYST_PASSWORD=XAI-Analyst-2026!
DEMO_REVIEWER_PASSWORD=XAI-Reviewer-2026!

# Detection defaults
ALERT_THRESHOLD=85.0
MODEL_SEED=42
WINDOW_MINUTES=60
STRIDE_MINUTES=15